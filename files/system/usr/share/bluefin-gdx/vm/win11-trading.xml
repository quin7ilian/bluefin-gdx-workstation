<!--
  Win11 trading VM template for bluefin-gdx-workstation.

  Requirements satisfied by the image: q35 + UEFI Secure Boot (edk2-ovmf) and
  emulated TPM 2.0 (swtpm) for Win11; libvirt/qemu-kvm pre-installed.

  GPU: dedicated RTX 4090 (GPU1 @ 0000:02:00.0) + its HDMI-audio function,
  passed through with managed='yes' (libvirt detaches from nvidia on start,
  reattaches on stop). The /etc/libvirt/hooks/qemu hook frees that GPU's
  local-AI model (ramalama-detector) first and restores it on shutdown.

  KEEP the domain name 'win11-trading' or the hook will not match.

  EDIT before first boot: the qcow2 disk path, the Windows ISO path, and the
  virtio-win ISO path (all under devices). Console is VNC (SPICE was removed
  from EL10). Display path for Sunshine is described inline on the video device.

  Define with:  sudo virsh define /usr/share/bluefin-gdx/vm/win11-trading.xml
-->
<domain type="kvm">
  <name>win11-trading</name>
  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/11"/>
    </libosinfo:libosinfo>
  </metadata>

  <memory unit="GiB">64</memory>
  <currentMemory unit="GiB">64</currentMemory>

  <!-- Latency: lock guest RAM (no swap; VFIO pins it anyway) and skip KSM
       page-merge scanning (a jitter source). THP already backs guest RAM with
       ~2 MiB pages, so explicit hugepages are an OPTIONAL second-order refinement
       — left OFF by default. 1 GiB hugepages trim TLB misses + THP-compaction
       jitter further, BUT reserved pages leave the HPO memory pool until freed,
       even while the VM is off. On this HPO box, prefer allocating them
       dynamically around the VM (a oneshot/the libvirt hook, freed on shutdown)
       over a permanent boot reservation. To use them, reserve on node 3 then
       uncomment the <hugepages> line. -->
  <memoryBacking>
    <locked/>
    <nosharepages/>
    <!-- <hugepages><page size="1" unit="GiB" nodeset="3"/></hugepages> -->
  </memoryBacking>

  <vcpu placement="static">16</vcpu>
  <iothreads>1</iothreads>

  <!-- NUMA pinning — the important bit for a latency-sensitive Windows guest.
       This 5995WX runs NPS4: 4 nodes, each 16C/32T + ~128 GiB, and BOTH RTX
       4090s sit on node 3 (host cpus 48-63 plus SMT siblings 112-127). We
       confine the ENTIRE VM to node 3, so its vCPUs, its memory, and the
       passed-through GPU are all node-local (no cross-node fabric hops, which
       cost ~20% latency here). The 16 vCPUs map onto ONE CCD (cores 48-55,
       which share a single 32 MB L3) as 8 cores x 2 threads, giving the guest
       one clean L3 domain too. Windows is presented a single flat node, so its
       weak NUMA balancer has nothing to get wrong. Emulator + iothread land on
       a separate node-3 core (56/57) so host threads never steal vCPU cycles. -->
  <cputune>
    <vcpupin vcpu="0"  cpuset="48"/>  <vcpupin vcpu="1"  cpuset="112"/>
    <vcpupin vcpu="2"  cpuset="49"/>  <vcpupin vcpu="3"  cpuset="113"/>
    <vcpupin vcpu="4"  cpuset="50"/>  <vcpupin vcpu="5"  cpuset="114"/>
    <vcpupin vcpu="6"  cpuset="51"/>  <vcpupin vcpu="7"  cpuset="115"/>
    <vcpupin vcpu="8"  cpuset="52"/>  <vcpupin vcpu="9"  cpuset="116"/>
    <vcpupin vcpu="10" cpuset="53"/>  <vcpupin vcpu="11" cpuset="117"/>
    <vcpupin vcpu="12" cpuset="54"/>  <vcpupin vcpu="13" cpuset="118"/>
    <vcpupin vcpu="14" cpuset="55"/>  <vcpupin vcpu="15" cpuset="119"/>
    <emulatorpin cpuset="56,120"/>
    <iothreadpin iothread="1" cpuset="57,121"/>
  </cputune>

  <!-- Bind guest memory strictly to node 3 (where its cores and GPU live). -->
  <numatune>
    <memory mode="strict" nodeset="3"/>
  </numatune>

  <os firmware="efi">
    <type arch="x86_64" machine="q35">hvm</type>
    <firmware>
      <feature enabled="yes" name="enrolled-keys"/>
      <feature enabled="yes" name="secure-boot"/>
    </firmware>
    <boot dev="cdrom"/>
    <boot dev="hd"/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <hyperv mode="custom">
      <relaxed state="on"/>
      <vapic state="on"/>
      <spinlocks state="on" retries="8191"/>
      <vpindex state="on"/>
      <synic state="on"/>
      <stimer state="on"/>
      <frequencies state="on"/>
    </hyperv>
    <vmport state="off"/>
    <smm state="on"/>
  </features>

  <cpu mode="host-passthrough" check="none" migratable="off">
    <topology sockets="1" dies="1" cores="8" threads="2"/>
    <cache mode="passthrough"/>
    <feature policy="require" name="topoext"/>
  </cpu>

  <clock offset="localtime">
    <timer name="rtc" tickpolicy="catchup"/>
    <timer name="pit" tickpolicy="delay"/>
    <timer name="hpet" present="no"/>
    <timer name="hypervclock" present="yes"/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled="no"/>
    <suspend-to-disk enabled="no"/>
  </pm>

  <devices>
    <emulator>/usr/libexec/qemu-kvm</emulator>

    <!-- Main disk. EDIT path. Create first, e.g.:
         sudo qemu-img create -f qcow2 /var/lib/libvirt/images/win11-trading.qcow2 200G -->
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" cache="none" io="native" discard="unmap" iothread="1"/>
      <source file="/var/lib/libvirt/images/win11-trading.qcow2"/>
      <target dev="vda" bus="virtio"/>
    </disk>

    <!-- Windows 11 install ISO. EDIT path. -->
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="/var/lib/libvirt/images/Win11.iso"/>
      <target dev="sda" bus="sata"/>
      <readonly/>
    </disk>

    <!-- virtio-win driver ISO so Windows sees the virtio disk/net at install.
         Grab the stable virtio-win.iso from the fedora virtio-win project. EDIT path. -->
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="/var/lib/libvirt/images/virtio-win.iso"/>
      <target dev="sdb" bus="sata"/>
      <readonly/>
    </disk>

    <controller type="usb" model="qemu-xhci" ports="15"/>
    <controller type="virtio-serial"/>

    <interface type="network">
      <source network="default"/>
      <model type="virtio"/>
    </interface>

    <!-- Dedicated RTX 4090 (GPU1 @ 0000:02:00.0) + HDMI-audio fn, managed detach. -->
    <hostdev mode="subsystem" type="pci" managed="yes">
      <source>
        <address domain="0x0000" bus="0x02" slot="0x00" function="0x0"/>
      </source>
    </hostdev>
    <hostdev mode="subsystem" type="pci" managed="yes">
      <source>
        <address domain="0x0000" bus="0x02" slot="0x00" function="0x1"/>
      </source>
    </hostdev>

    <!-- TPM 2.0 (Win11 requirement) via swtpm. -->
    <tpm model="tpm-crb">
      <backend type="emulator" version="2.0"/>
    </tpm>

    <!-- Console for install/recovery. SPICE is removed from EL10 so this is VNC
         on localhost (virt-manager tunnels to it). 'vga' works in the Windows
         installer with no driver. After installing virtio-win you may switch to
         <model type='virtio'/>. Once Sunshine streams the 4090 via a
         virtual-display driver, you can set <model type='none'/> to drop the
         emulated head (which is what avoids the dual-display capture confusion). -->
    <video>
      <model type="vga"/>
    </video>
    <graphics type="vnc" port="-1" autoport="yes" listen="127.0.0.1"/>

    <input type="tablet" bus="usb"/>
    <input type="keyboard" bus="usb"/>

    <!-- qemu-guest-agent channel (clean shutdown, IP reporting). Install the
         guest agent from the virtio-win ISO inside Windows. -->
    <channel type="unix">
      <target type="virtio" name="org.qemu.guest_agent.0"/>
    </channel>

    <!-- No balloon: it fights locked/hugepage memory and adds jitter. -->
    <memballoon model="none"/>
    <rng model="virtio">
      <backend model="random">/dev/urandom</backend>
    </rng>

    <!-- If the passed-through GPU shows Code 43 in Windows, hide the hypervisor:
         add <kvm><hidden state='on'/></kvm> here and a
         <vendor_id state='on' value='1234567890ab'/> inside <hyperv> above.
         Modern NVIDIA drivers (R465+) usually do NOT need this. -->
  </devices>
</domain>
