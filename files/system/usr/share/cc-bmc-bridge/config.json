{
  "_comment_purpose": "Template config for cc-plugin-custom-device on this WRX80 Creator R2.0 workstation. Copied to /etc/coolercontrol/plugins/custom-device/config.json by 'ujust install-cc-plugin' (skip-if-exists; safe to edit in place). After edits: sudo systemctl restart coolercontrold.",
  "_comment_mapping": "Channels 1-7: CPU_FAN1, CPU_FAN2/WP (rear), CHA_FAN1/WP (bottom hub), CHA_FAN2/WP (top front), CHA_FAN3/WP (bottom front), SB_FAN1 (chipset), MOS_FAN1 (VRM).",
  "_comment_wrapper": "All reads go through /usr/libexec/cc-bmc-sensor.sh which caches `ipmitool sensor list` output for 5s. This reduces 17 sequential BMC roundtrips per CC poll cycle to 1 — avoids CoolerControl's plugin-response timeout that produced 'Significant issue retrieving status / Setting failsafe values' log spam.",
  "devices": [
    {
      "id": "wrx80-bmc",
      "label": "WRX80 BMC",
      "channels": [
        {
          "id": "cpu_fan",
          "label": "CPU Fan",
          "commands": {
            "get_rpm": "/usr/libexec/cc-bmc-sensor.sh CPU_FAN1 fan",
            "set_duty": "/usr/libexec/cc-set-fan-duty.sh 1 {duty}",
            "enable_manual": "true",
            "reset": "true"
          }
        },
        {
          "id": "rear_exhaust",
          "label": "Rear exhaust",
          "commands": {
            "get_rpm": "/usr/libexec/cc-bmc-sensor.sh CPU_FAN2/WP fan",
            "set_duty": "/usr/libexec/cc-set-fan-duty.sh 2 {duty}",
            "enable_manual": "true",
            "reset": "true"
          }
        },
        {
          "id": "bottom_hub",
          "label": "Bottom hub (3× GP-18)",
          "commands": {
            "get_rpm": "/usr/libexec/cc-bmc-sensor.sh CHA_FAN1/WP fan",
            "set_duty": "/usr/libexec/cc-set-fan-duty.sh 3 {duty}",
            "enable_manual": "true",
            "reset": "true"
          }
        },
        {
          "id": "top_front",
          "label": "Top front (GP-14)",
          "commands": {
            "get_rpm": "/usr/libexec/cc-bmc-sensor.sh CHA_FAN2/WP fan",
            "set_duty": "/usr/libexec/cc-set-fan-duty.sh 4 {duty}",
            "enable_manual": "true",
            "reset": "true"
          }
        },
        {
          "id": "bottom_front",
          "label": "Bottom front (GP-14)",
          "commands": {
            "get_rpm": "/usr/libexec/cc-bmc-sensor.sh CHA_FAN3/WP fan",
            "set_duty": "/usr/libexec/cc-set-fan-duty.sh 5 {duty}",
            "enable_manual": "true",
            "reset": "true"
          }
        },
        {
          "id": "sb_fan",
          "label": "Chipset (SB_FAN1)",
          "commands": {
            "get_rpm": "/usr/libexec/cc-bmc-sensor.sh SB_FAN1 fan",
            "set_duty": "/usr/libexec/cc-set-fan-duty.sh 6 {duty}",
            "enable_manual": "true",
            "reset": "true"
          }
        },
        {
          "id": "mos_fan",
          "label": "VRM (MOS_FAN1)",
          "commands": {
            "get_rpm": "/usr/libexec/cc-bmc-sensor.sh MOS_FAN1 fan",
            "set_duty": "/usr/libexec/cc-set-fan-duty.sh 7 {duty}",
            "enable_manual": "true",
            "reset": "true"
          }
        }
      ],
      "temps": [
        { "id": "cpu",          "label": "CPU",             "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_CPU temp" },
        { "id": "vrm",          "label": "VRM",             "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_VRM temp" },
        { "id": "motherboard",  "label": "Motherboard",     "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_MB temp" },
        { "id": "lan_ambient",  "label": "10G LAN ambient", "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_10G_LAN_AMB temp" },
        { "id": "ddr4_a",       "label": "DDR4 A",          "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_DDR4_A temp" },
        { "id": "ddr4_b",       "label": "DDR4 B",          "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_DDR4_B temp" },
        { "id": "ddr4_c",       "label": "DDR4 C",          "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_DDR4_C temp" },
        { "id": "ddr4_d",       "label": "DDR4 D",          "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_DDR4_D temp" },
        { "id": "ddr4_e",       "label": "DDR4 E",          "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_DDR4_E temp" },
        { "id": "ddr4_f",       "label": "DDR4 F",          "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_DDR4_F temp" },
        { "id": "ddr4_g",       "label": "DDR4 G",          "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_DDR4_G temp" },
        { "id": "ddr4_h",       "label": "DDR4 H",          "command": "/usr/libexec/cc-bmc-sensor.sh TEMP_DDR4_H temp" }
      ]
    }
  ]
}
