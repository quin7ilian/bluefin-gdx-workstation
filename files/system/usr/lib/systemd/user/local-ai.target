# Groups the local Ramalama AI model services so one toggle governs them all.
# Gated by the flag file ~/.config/local-ai/enabled: when the flag is absent
# (HPO MODE) the ConditionPathExists fails and this target — and every service
# WantedBy it — is skipped cleanly (not failed), so nothing starts at boot or
# on a stray `systemctl start`. `ujust toggle-ai-mode` creates/removes the flag
# and starts/stops this target. The same condition is repeated on each service
# because a failed condition on a target does NOT conditionalize its wanted
# units — systemd still queues them — so each unit must gate itself too.
[Unit]
Description=Local GPU AI services (gated by ~/.config/local-ai/enabled)
ConditionPathExists=%h/.config/local-ai/enabled

[Install]
WantedBy=default.target
