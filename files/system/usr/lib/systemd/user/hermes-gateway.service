[Unit]
Description=Hermes Agent gateway — shared agent backend (OpenAI-compatible API on 127.0.0.1:8642)
Documentation=https://hermes-agent.nousresearch.com
# Why this exists: this is the single, long-lived Hermes "brain". Running
# `hermes gateway` starts the configured gateway platforms, including the
# api_server platform which exposes an OpenAI-compatible HTTP API on
# 127.0.0.1:8642. Other surfaces (the web UI in gateway mode, messaging)
# connect to THIS process instead of each spawning their own agent — so they
# share one live runtime, one memory-curation owner (Hindsight bank `main`),
# and one claim-discipline pipeline. (Zed/ACP is the exception by design: it
# is stdio-spawned per-editor and shares only the durable memory, not this
# live runtime.)
#
# This unit owns the SERVICE only. The Hermes install, its config, and the
# api_server platform are user/home concerns and are NOT baked into the image:
#   - `hermes` is installed in $HOME (self-updating; can't live on the
#     immutable image). The unit resolves it from the user's PATH via a login
#     shell, so ~/.local/bin etc. are picked up.
#   - The api_server platform auto-enables when API_SERVER_KEY is set in
#     ~/.hermes/.env (no `hermes gateway setup` needed); without the key it
#     refuses to start.
# Enable via `ujust enable-hermes-gateway`.

[Service]
Type=simple
# Resolve `hermes` from the user's normal environment (login shell) rather
# than hardcoding a home path — keeps this unit free of personal/user-specific
# paths. `hermes gateway run` runs in the foreground (correct for a service).
ExecStart=/usr/bin/bash -lc 'exec hermes gateway run'
Restart=on-failure
RestartSec=3
# A long-lived agent backend; soft pressure to surface leaks, no hard OOM-kill.
MemoryHigh=4G

[Install]
WantedBy=default.target
