[Unit]
Description=Pin amdgpu MCLK at highest DPM state (Navi 33 ultrawide high-refresh blanking workaround)
Documentation=https://bbs.archlinux.org/viewtopic.php?id=311159
# Wait until DRM/udev have fully settled so /sys/class/drm/card*/device/pp_dpm_mclk
# is populated.
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pin-amdgpu-mclk.sh

[Install]
WantedBy=multi-user.target
